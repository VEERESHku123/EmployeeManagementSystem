@using Frontend.Models.EmployeeDocument

@{
    var categories = ViewBag.DocumentCategories as List<DocumentCategoryModel>;
    var documentTypes = ViewBag.DocumentTypes as List<DocumentTypeModel>;
    var uploadedDocuments = ViewBag.UploadedDocuments as List<EmployeeDocumentModel>;
    var employeeId = ViewBag.EmployeeId;
}

<link rel="stylesheet" href="~/css/employee-document-upload.css" />

<div class="container">

    <div class="page-header mb-4">
        <h2>Verify Employee Documents</h2>
        <p>Review uploaded documents and take action.</p>
    </div>

    <div class="category-nav">

        @foreach (var category in categories)
        {
            <button type="button"
                    class="category-btn"
                    onclick="showCategory(@category.CategoryId,this)">
                @category.CategoryName
            </button>
        }

    </div>

    @foreach (var category in categories)
    {
        <div id="category-@category.CategoryId"
             class="category-section"
             style="display:none;">

            <div class="row">

                @foreach (var docType in documentTypes
                    .Where(x => x.CategoryId == category.CategoryId))
                {
                    var uploadedDoc = uploadedDocuments?
                        .FirstOrDefault(x =>
                            x.DocumentTypeId == docType.DocumentTypeId);

                    if (uploadedDoc == null)
                    {
                        continue;
                    }

                    <div class="col-md-6 mb-4">

                        <div class="document-card">

                            <div class="uploaded-container">

                                <h5 class="document-title">
                                    @docType.DocumentName

                                    @if (docType.IsMandatory == true)
                                    {
                                        <span class="required">*</span>
                                    }
                                </h5>

                                <div class="uploaded-success">
                                    ✓ Document Uploaded
                                </div>

                                <div class="document-info">

                                    <p>
                                        <strong>Status:</strong>
                                        @uploadedDoc.VerificationStatus
                                    </p>

                                    <p>
                                        <strong>Uploaded:</strong>
                                        @uploadedDoc.UploadedDate.ToString("dd-MMM-yyyy")
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(uploadedDoc.Remarks))
                                    {
                                        <p>
                                            <strong>Remarks:</strong>
                                            @uploadedDoc.Remarks
                                        </p>
                                    }

                                </div>

                                <div class="mt-3">

                                    <button type="button"
                                            class="btn-view"
                                            onclick="viewDocument('@uploadedDoc.DownloadUrl')">
                                        View
                                    </button>

                                    <button type="button"
                                            class="btn btn-success"
                                            onclick="approveDocument('@uploadedDoc.DocumentId')">
                                        Approve
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning"
                                            onclick="rejectDocument('@uploadedDoc.DocumentId')">
                                        Reject
                                    </button>

                                    <form asp-action="DeleteDocument"
                                          asp-controller="EmployeeDocument"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="employeeId"
                                               value="@employeeId" />

                                        <input type="hidden"
                                               name="documentId"
                                               value="@uploadedDoc.DocumentId" />

                                        <button type="submit"
                                                class="btn-delete"
                                                onclick="return confirm('Delete this document?')">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>

<div class="modal fade"
     id="documentModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Document Preview
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <iframe id="documentFrame"
                        class="document-frame">
                </iframe>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        function showCategory(categoryId, button)
        {
            document.querySelectorAll(".category-section")
                .forEach(section => {
                    section.style.display = "none";
                });

            document
                .getElementById("category-" + categoryId)
                .style.display = "block";

            document
                .querySelectorAll(".category-btn")
                .forEach(btn => btn.classList.remove("active"));

            button.classList.add("active");
        }

        function viewDocument(url)
        {
            document.getElementById("documentFrame").src = url;

            new bootstrap.Modal(
                document.getElementById("documentModal"))
                .show();
        }

        function approveDocument(documentId)
        {
            alert("Implement Approve API call");
        }

        function rejectDocument(documentId)
        {
            alert("Implement Reject API call");
        }

        window.onload = function ()
        {
            const firstButton =
                document.querySelector(".category-btn");

            if (firstButton)
            {
                firstButton.click();
            }
        };

    </script>
}
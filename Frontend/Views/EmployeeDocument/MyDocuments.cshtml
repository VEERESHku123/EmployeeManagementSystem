@model List<Frontend.Models.EmployeeDocument.EmployeeDocumentModel>

@{
    ViewData["Title"] = "My Documents";
}

<div class="container mt-4">

    <h2 class="mb-4">My Documents</h2>

    @if (Model == null)
    {
        <div class="alert alert-danger">
            Model is NULL
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-warning">
            No documents found.
        </div>
    }
    else
    {
        <div class="row">

            <!-- Document List -->
            <div class="col-md-4">

                <div class="list-group">

                    @foreach (var document in Model)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                onclick="showDocument('@document.DownloadUrl', '@document.DocumentTypeName')">

                            <strong>@document.DocumentTypeName</strong>
                            <br />

                            <small>
                                Status: @document.VerificationStatus
                            </small>

                            <br />

                            <small>
                                Uploaded:
                                @document.UploadedDate.ToString("dd-MMM-yyyy")
                            </small>

                        </button>
                    }

                </div>

            </div>

            <!-- Document Viewer -->
            <div class="col-md-8">

                <div class="card">

                    <div class="card-header">
                        <h5 id="documentTitle" class="mb-0">
                            Select a document
                        </h5>
                    </div>

                    <div class="card-body p-0">

                        <iframe id="documentViewer"
                                width="100%"
                                height="700"
                                style="border:none;">
                        </iframe>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@section Scripts
{
    <script>

        function showDocument(url, title)
        {
            if (!url)
            {
                alert("Document URL not available.");
                return;
            }

            document.getElementById("documentTitle").innerText = title;
            document.getElementById("documentViewer").src = url;
        }

        window.onload = function ()
        {
            @if (Model != null && Model.Any())
            {
                    <text>
                            showDocument(
                                '@Html.Raw(Model.First().DownloadUrl)',
                                '@Html.Raw(Model.First().DocumentTypeName)'
                            );
                    </text>
            }
        };

    </script>
}
@model List<Frontend.Models.EmployeeDocument.EmployeeDocumentModel>

@{
    ViewData["Title"] = "My Documents";
}

<div class="container mt-4">

    <h2 class="mb-4">My Documents</h2>

    <div class="row">
        <h3>Count = @(Model?.Count ?? 0)</h3>
        <!-- Document Types -->
        <div class="col-md-3">

            <div class="list-group">

                @foreach (var document in Model)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action"
                            onclick="showDocument('@document.DownloadUrl',
                        '@document.DocumentTypeName')">

                        <strong>
                            @document.DocumentTypeName
                        </strong>

                        <br />

                        <small>
                            Status: @document.VerificationStatus
                        </small>
                    </button>
                }

            </div>

        </div>

        <!-- Document Viewer -->
        <div class="col-md-9">

            <div class="card">

                <div class="card-header">
                    <h5 id="documentTitle">
                        Select a document
                    </h5>
                </div>

                <div class="card-body p-0">

                    <iframe id="documentViewer"
                            width="100%"
                            height="700"
                            style="border:none;">
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    function showDocument(url, title) {

        document.getElementById("documentViewer").src = url;
        document.getElementById("documentTitle").innerText = title;

    }

    window.onload = function () {

        @if (Model != null && Model.Any())
        {
                <text>
                        showDocument(
                            '@Model.First().DownloadUrl',
                            '@Model.First().DocumentTypeName'
                        );
                </text>
        }

    };

</script>
@model IEnumerable<Frontend.Models.Employee.EmployeeModel>

<table class="table">

    <thead>
        <tr>
            <th>Employee Id</th>
            <th>Name</th>
            <th>Job Title</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr style="cursor:pointer" onclick="loadEmployee('@item.EmployeeId')">

                <td>@item.EmployeeId</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.DepartmentId</td>

            </tr>
        }

    </tbody>

</table>

@if (ViewBag.TotalPages != null)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    <div style="display:flex; justify-content:center; margin-top:20px; gap:6px;">

        @if (currentPage > 1)
        {
            <a class="btn btn-outline-primary pagination-link"
               href="@Url.Action("GetAllEmployees", new
               {
                   page = currentPage - 1,
                   pageSize = ViewBag.PageSize,
                   search = ViewBag.Search
               })">
                Prev
            </a>
        }

        @* First page *@
        @if (currentPage > 3)
        {
            <a class="btn btn-outline-primary pagination-link"
               href="@Url.Action("GetAllEmployees", new
               {
                   page = 1,
                   pageSize = ViewBag.PageSize,
                   search = ViewBag.Search
               })">
                1
            </a>

            @if (currentPage > 4)
            {
                <span class="btn btn-light disabled">...</span>
            }
        }

        @* Pages around current page *@
        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
        {
            <a class="btn @(i == currentPage ? "btn-primary" : "btn-outline-primary") pagination-link"
               href="@Url.Action("GetAllEmployees", new
               {
                   page = i,
                   pageSize = ViewBag.PageSize,
                   search = ViewBag.Search
               })">
                @i
            </a>
        }

        @* Last page *@
        @if (currentPage < totalPages - 2)
        {
            @if (currentPage < totalPages - 3)
            {
                <span class="btn btn-light disabled">...</span>
            }

            <a class="btn btn-outline-primary pagination-link"
               href="@Url.Action("GetAllEmployees", new
               {
                   page = totalPages,
                   pageSize = ViewBag.PageSize,
                   search = ViewBag.Search
               })">
                @totalPages
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a class="btn btn-outline-primary pagination-link"
               href="@Url.Action("GetAllEmployees", new
               {
                   page = currentPage + 1,
                   pageSize = ViewBag.PageSize,
                   search = ViewBag.Search
               })">
                Next
            </a>
        }

    </div>
}

<link href="~/css/bulkuploadresult.css" rel="stylesheet" />

<div id="uploadSummaryContainer" class="summary-container" style="display:none;">

    <div class="summary-card success-card">
        <div class="summary-icon">✓</div>
        <div>
            <div class="summary-title">Successful Records</div>
            <div id="successCount" class="summary-count">0</div>
        </div>
    </div>

    <div class="summary-card failed-card">
        <div class="summary-icon">✕</div>
        <div>
            <div class="summary-title">Failed Records</div>
            <div id="failedCount" class="summary-count">0</div>
        </div>
    </div>

</div>

<div id="invalidFileContainer"
     class="mt-3"
     style="display:none;">

    <a id="invalidFileDownloadLink"
       class="btn btn-warning">
        Download Invalid Employees Excel
    </a>

</div>

<div id="invalidEmployeesContainer"
     class="mt-4"
     style="display:none;">

    <h5>Invalid Employees</h5>

    <table id="errorTable"
           class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Employee Id</th>
                <th>Employee Name</th>
                <th>Error</th>
            </tr>
        </thead>

        <tbody id="invalidEmployeesTableBody">
        </tbody>

    </table>

</div>
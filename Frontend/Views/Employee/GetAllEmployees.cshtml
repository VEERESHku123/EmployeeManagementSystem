@model IEnumerable<Frontend.Models.Employee.EmployeeModel>

@{
    ViewData["Title"] = "GetAllEmployees";
}

<link rel="stylesheet" href="~/css/employee-list.css" />

<div class="table-wrapper">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">

        <form id="pageSizeForm"
              method="get"
              asp-action="GetAllEmployees"
              asp-controller="Employee"
              style="display:flex; align-items:center; gap:10px;">

            <label>Show</label>

            <select id="pageSizeSelect"
                    name="pageSize"
                    class="form-select"
                    style="width:80px;">

                <option value="5" selected="@(ViewBag.PageSize == 5)">5</option>
                <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>

            </select>

            <label>Entries</label>
        </form>

        <!-- SEARCH -->
        <form id="searchForm"
              method="get"
              asp-action="GetAllEmployees"
              asp-controller="Employee">

            <input type="text"
                   id="searchInput"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search employees..."
                   class="form-control"
                   style="width:250px;" />

        </form>

    </div>

    <div id="table-container" class="table-container">
        @await Html.PartialAsync("EmployeeTable", Model)
    </div>

</div>


@section Scripts {
    <script src="~/js/employee-list.js"></script>
}
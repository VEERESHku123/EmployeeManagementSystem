@model Frontend.Models.EmployeeModel

@{
    ViewData["Title"] = "GetEmployeeById";
    var role = Context.Session.GetString("Role");
    var email = Context.Session.GetString("Email");
}

<link rel="stylesheet" href="~/css/employee-details.css" />

<div class="employee-card">

    <h2 class="employee-title">
        Employee Details -
        <span class="employee-name">
            @Model.FirstName @Model.LastName
        </span>
    </h2>

    <dl class="row employee-dl">

        <dt class="col-sm-3">Employee ID</dt>
        <dd class="col-sm-9">@Model.EmployeeId</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-3">
            Phone Number
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-3">
            Gender
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Gender)
        </dd>

        <dt class="col-sm-3">
            Job Title
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Designation)
        </dd>

        <dt class="col-sm-3">
            Salary
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Salary)
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.IsActive)
        </dd>

        <dt class="col-sm-3">
            Department Id
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DepartmentId)
        </dd>

        <dt class="col-sm-3">
            Manager Id
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ManagerId)
        </dd>

    </dl>
   
    <div class="mt-4 text-center">
        @if (role == "Admin" || email == Model.Email)
        {
            <a asp-action="UpdateEmployee"
               asp-route-id="@Model.EmployeeId"
               class="btn-custom btn-edit">
                Edit
            </a>
        }
        @if(role == "Admin")
        {
            <button id="deleteBtn"
                    data-id="@Model.EmployeeId"
                    class="btn-custom btn-edit">
                Remove
            </button>
        }
        
        <a asp-action="GetAllEmployees"
           asp-controller="Employee"
           class="btn-custom btn-back">
            Back to List
        </a>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.getElementById("deleteBtn")?.addEventListener("click", function () {

    const id = this.dataset.id;

    Swal.fire({
        title: "Are you sure?",
        text: "Employee will be deleted permanently!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, Delete"
    }).then(async (result) => {

    if(result.isConfirmed){

    const response = await fetch('/employee/delete', {
    method: 'POST',
    headers: {
        'Content-Type':'application/json'
        },
        body: JSON.stringify(id)
    });

    if(response.ok){
        window.location.href='/employee/all';
    }
    else{
        Swal.fire("Error","Delete failed","error");
        }
        }
    });

    });
</script>
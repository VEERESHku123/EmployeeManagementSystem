@using Frontend.Models.Leave
@model LeaveApplyViewModel

<div class="leave-header">
    <div>
        <h2>Apply for Leave</h2>
        <p>Select your leave type and submit your request.</p>
    </div>

    <button type="button"
            id="btnBackToHistory"
            class="apply-leave-btn"
            style="display:none;">
        ← Back
    </button>
</div>

<div class="leave-card">

    <form id="leaveApplyForm" method="post" action="/leave/apply">

    <div class="form-group">

        <label>Leave Type</label>

            <select asp-for="ApplyLeave.LeaveTypeId" id="leaveType" class="form-control">

                <option value="">Select Leave Type</option>

                @foreach (var leave in Model.LeaveBalances)
                {
                    <option value="@leave.LeaveTypeId"
                            data-balance="@leave.AvailableLeaves">
                        @leave.LeaveTypeName
                    </option>
                }
            </select>

            <span asp-validation-for="ApplyLeave.LeaveTypeId" class="field-error"></span>

    </div>

    <div class="balance-card">

        <span class="balance-label">
            Available Balance
        </span>

        <span id="availableBalance"
              class="balance-value">
            --
        </span>

    </div>

    <div class="leave-row">

        <div class="leave-col">

            <label>Start Date</label>

                <input asp-for="ApplyLeave.StartDate"
                       type="date"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

            <span asp-validation-for="ApplyLeave.StartDate" class="field-error"></span>

        </div>

        <div class="leave-col">

            <label>End Date</label>

                <input asp-for="ApplyLeave.EndDate"
                       type="date"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

            <span asp-validation-for="ApplyLeave.EndDate" class="field-error"></span>

        </div>

    </div>

    <div class="form-group">

        <label>Reason</label>

        <textarea asp-for="ApplyLeave.Reason" rows="5" maxlength="500" class="form-control"></textarea>

        <span asp-validation-for="ApplyLeave.Reason" class="field-error"></span>
    </div>

    <div id="formError"
         class="alert alert-danger"
         style="display:none;">
    </div>

    <button type="submit"
            class="submit-btn">
        Submit Leave Request
    </button>

</form>

</div>
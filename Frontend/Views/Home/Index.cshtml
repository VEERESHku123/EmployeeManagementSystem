<div class="hero-container">

    <div class="hero-content">

        <h2>Welcome To EMS App!</h2>

        <p>
            Please signIn to continue and
            access dashboard.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           asp-route-showLogin="true"
           class="hero-btn">

            SignIn →
        </a>

    </div>

    <div class="hero-right">

        @if (ViewBag.ShowActivate == true)
        {
            <partial name="~/Views/User/_ActivateAccount.cshtml"
                     model="Model" />
        }
        else if (ViewBag.ShowLogin == true)
        {
            <partial name="~/Views/User/_SignIn.cshtml" />
        }
        else
        {
            <video autoplay muted loop>

                <source src="~/videos/ems-animation.mp4"
                        type="video/mp4" />

            </video>
        }

    </div>

</div>
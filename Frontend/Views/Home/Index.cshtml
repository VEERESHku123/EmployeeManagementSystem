<div class="hero-container">

    <div class="hero-content">
        <h1>Employee Management System</h1>

        <p>
            Please sign in to continue and access your dashboard,
            profile, documents and employee services.
        </p>

        <a href="javascript:void(0)"
           class="hero-btn"
           onclick="loadPartial('/User/SignIn')">
            Sign In →
        </a>
    </div>

    <div class="hero-right">

        <div class="hero-card" id="heroCard">

            @if (ViewBag.ShowActivate == true)
            {
                <partial name="~/Views/User/_ActivateAccount.cshtml"
                         model="Model" />
            }
            else if (ViewBag.ShowLogin == true)
            {
                <partial name="~/Views/User/_SignIn.cshtml" />
            }
            else
            {
                <video autoplay muted loop>
                    <source src="~/videos/ems-animation.mp4"
                            type="video/mp4" />
                </video>
            }

        </div>

    </div>

</div>

<script>
    function loadPartial(url) {

        fetch(url)
            .then(response => response.text())
            .then(html => {

                document.getElementById('heroCard').innerHTML = html;

                $.validator.unobtrusive.parse('#heroCard');
            })
            .catch(error => console.error(error));
    }
</script>
<div class="text-center">

    <h2>Microsoft Login Demo</h2>

    @if (Context.Session.GetString("JWT") == null)
    {
        <a class="btn btn-primary"
           asp-controller="Account"
           asp-action="Login">
            Login with Microsoft
        </a>
    }
    else
    {
        <h4>Logged In</h4>

        <a class="btn btn-danger"
           asp-controller="Account"
           asp-action="Logout">
            Logout
        </a>
    }

</div>
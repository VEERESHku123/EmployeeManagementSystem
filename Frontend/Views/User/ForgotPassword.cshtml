<link rel="stylesheet" href="~/css/forgot-password.css" asp-append-version="true" />

<div class="forgot-password-container">

    <div class="card">

        <h2 id="formTitle">Forgot Password</h2>

        <!-- Email + OTP Section -->
        <div id="verificationSection">

            <input type="email"
                   id="email"
                   placeholder="Enter Email" />

            <button id="sendOtpBtn"
                    onclick="sendOtp()">
                Send OTP
            </button>

            <!-- Hidden initially -->
            <div id="otpArea" style="display:none;">

                <div class="otp-boxes">
                    <input maxlength="1" class="otp-digit" />
                    <input maxlength="1" class="otp-digit" />
                    <input maxlength="1" class="otp-digit" />
                    <input maxlength="1" class="otp-digit" />
                    <input maxlength="1" class="otp-digit" />
                    <input maxlength="1" class="otp-digit" />
                </div>

                <div class="timer-area">
                    OTP expires in
                    <span id="otpTimer">05:00</span>
                </div>

                <button id="verifyBtn" onclick="verifyOtp()">
                    Verify OTP
                </button>

                <button id="resendOtpBtn"
                        onclick="resendOtp()"
                        style="display:none;">
                    Resend OTP
                </button>

            </div>

        </div>

        <!-- Reset Password -->
        <div id="resetSection"
             class="reset-section"
             style="display:none">

            <input type="password"
                   id="newPassword"
                   placeholder="New Password" />

            <input type="password"
                   id="confirmPassword"
                   placeholder="Confirm Password" />

            <input type="hidden" id="resetToken" />

            <button onclick="resetPassword()">
                Update Password
            </button>

        </div>

    </div>

</div>
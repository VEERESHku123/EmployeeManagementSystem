@model Frontend.Models.User.SignInModel

<link rel="stylesheet"
      href="~/css/signin.css"
      asp-append-version="true" />

<div class="login-card">

    <h2>SignIn</h2>

    <form asp-controller="User"
          asp-action="SignIn"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-2">
        </div>


        <input asp-for="Email"
               class="form-control"
               placeholder="Email" />

        <span asp-validation-for="Email"
              class="text-danger">
        </span>


        <input asp-for="Password"
               type="password"
               class="form-control"
               placeholder="Password" />

        <span asp-validation-for="Password"
              class="text-danger">
        </span>


        <button class="login-btn">
            Login
        </button>

    </form>


    <div class="divider">
        <span>OR</span>
    </div>


    <!-- Microsoft Login -->
    <a asp-controller="User"
       asp-action="MicrosoftSignIn"
       class="microsoft-btn">

        <img src="https://img.icons8.com/color/24/microsoft.png" />

        Continue with Microsoft

    </a>


    <div class="bottom-link">
        <div class="link-row">
            <span>First time user?</span>
            <a href="javascript:void(0)"
               onclick="loadPartial('/User/ActivateAccount')">
                Activate Account
            </a>
        </div>

        <div class="link-row">
            <span>Forgot Password?</span>
            <a asp-controller="User"
               asp-action="ForgotPassword">
                Reset Password
            </a>
        </div>
    </div>

</div>
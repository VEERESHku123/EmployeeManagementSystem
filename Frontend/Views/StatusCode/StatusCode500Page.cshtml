@{
    Layout = null;
    ViewData["Title"] = "StatusCode500Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html, body {
                width: 100%;
                height: 100%;
                overflow: hidden;
                background: #000;
            }

            .error-container {
                width: 100vw;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: black;
            }

                .error-container img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain; /* shows full image */
                }
    </style>
</head>
<body>

    <div class="error-container">
        <img src="~/images/500.jpg" alt="500 Error" />
        <div class="overlay"></div>
    </div>

</body>
</html>
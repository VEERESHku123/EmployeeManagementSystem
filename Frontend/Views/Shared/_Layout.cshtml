<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-theme.css" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="hero-bg">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand ms-2" asp-area="">Employee Management App</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1" >
                        @if (Context.Session.GetString("AccessToken") != null)
                            {  
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Employee" asp-action="GetAllEmployees">Home</a>
                            </li>
                            }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Employee"
                                   asp-action="AddNewEmployee">

                                    New Employee

                                </a>

                            </li>
                        }
                    </ul>

                    <!-- Right menu -->
                    <ul class="navbar-nav ms-auto me-2">

                        @if (Context.Session.GetString("AccessToken") == null)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3 py-1 rounded-pill shadow-sm custom-btn"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-showLogin="true">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    SignIn
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm px-3 py-1 rounded-pill shadow-sm custom-btn"
                                   asp-controller="User"
                                   asp-action="SignOut">
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    SignOut
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- COMMON BACKGROUND -->
    <div class="global-bg">

        <div class="bg-lines"></div>

        <div class="bubble bubble1"></div>
        <div class="bubble bubble2"></div>
        <div class="bubble bubble3"></div>

    </div>
    @if (TempData["SuccessMessage"] != null ||
     TempData["ErrorMessage"] != null)
    {
        <script>

            let icon =
            '@(TempData["SuccessMessage"] != null ? "success" : "error")';

            let message =
            '@(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])';

            Swal.fire({
            icon: icon,
            title: icon === 'success' ? 'Success' : 'Error',
            text: message,
            timer: 3000,
            showConfirmButton: false
            });

        </script>
    }
    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Frontend - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        setTimeout(() => {
            document.querySelectorAll('.alert').forEach(a => {
            a.style.display = "none";
            });
        }, 3000);
    </script>
</body>
</html>

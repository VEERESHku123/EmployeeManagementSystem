<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-theme.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="hero-bg">

    @if (Context.Session.GetString("AccessToken") == null)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

                <div class="container-fluid">

                    <a class="navbar-brand ms-2">
                        Employee Management App
                    </a>

                    <div class="ms-auto">

                        <a class="btn btn-outline-light btn-sm px-3 py-1 rounded-pill shadow-sm custom-btn"
                           href="javascript:void(0)"
                           onclick="loadPartial('/User/SignIn')">
                                
                           Sign In 

                        </a>

                    </div>

                </div>

            </nav>
        </header>
    }


    <div class="container-fluid px-0">

        <div class="row g-0">

            @if (Context.Session.GetString("AccessToken") != null)
            {
                <div class="sidebar">

                    <div class="sidebar-logo">
                        EMS
                    </div>


                    <ul class="nav flex-column">
                        @*------------------------ Admin Side Bar ----------------------*@

                        @if(User.IsInRole("Admin")) {
                            <li>
                                <a asp-action="GetAllEmployees"
                                   asp-controller="Employee"
                                   class="nav-link">

                                    Dashboard

                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)"
                                   class="nav-link"
                                   onclick="loadPage('/employee/add')">

                                    Add Employee

                                </a>
                            </li>

                            <li>
                                <a href="javascript:void(0)"
                                   class="nav-link"
                                   onclick="loadPage('/document/PendingDocuments')">

                                    Verify Documents

                                </a>
                            </li>
                        }
                        @* -------------User Side Bar ---------------------------- *@
                        else {
                            <li>
                                <a class="nav-link"
                                   asp-controller="Employee"
                                   asp-action="EmployeeDashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li>
                                <a href="javascript:void(0)"
                                   class="nav-link"
                                   onclick="loadPage('/employee/update')">
                                    Update Profile
                                </a>
                            </li>
                        }
                        @*--------------------- Common Side Bar ---------------------*@
                        <li>
                            <a href="javascript:void(0)"
                               class="nav-link"
                               onclick="loadPage('/document/upload')">

                                Upload Doc

                            </a>
                        </li>
                        <li class="profile-section">

                            <a class="profile-link"
                               href="javascript:void(0)"
                               onclick="loadPage('/employee')">

                                <div class="profile-icon">
                                    <i class="bi bi-person-fill"></i>
                                </div>

                                <div>
                                    <div class="fw-bold">@User.Identity?.Name</div>
                                </div>

                            </a>

                            <a class="logout-btn"
                               asp-controller="User"
                               asp-action="SignOut">

                                <i class="bi bi-box-arrow-right me-2"></i>
                                Sign Out

                            </a>

                        </li>

                    </ul>

                </div>

                <div class="main-content">

                    <main role="main" id="mainContent">

                        @RenderBody()

                    </main>

                </div>
            }
            else
            {
                <div class="col-12">

                    <main role="main">

                        @RenderBody()

                    </main>

                </div>
            }

        </div>

    </div>

    <div class="global-bg">

        <div class="bg-lines"></div>

        <div class="bubble bubble1"></div>
        <div class="bubble bubble2"></div>
        <div class="bubble bubble3"></div>

    </div>


    @if (TempData["SuccessMessage"] != null ||TempData["ErrorMessage"] != null)
    {
        <script>

            const icon =
            '@(TempData["SuccessMessage"] != null ? "success" : "error")';

            const message =
            '@(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])';

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {

                toast.addEventListener(
                    'mouseenter',
                    Swal.stopTimer
                );

                toast.addEventListener(
                    'mouseleave',
                    Swal.resumeTimer
                );
                }
            });

            Toast.fire({
                icon: icon,
                title: message
            });

        </script>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/employee-document-upload.js"></script>
    <script src="~/js/verify-documents.js"></script>
    <script src="~/js/pending-documents.js"></script>
    <script src="~/js/employee-add.js"></script>
    <script src="~/js/get-all-employees.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

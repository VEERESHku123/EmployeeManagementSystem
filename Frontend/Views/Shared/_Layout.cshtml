<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Frontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-theme.css" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="hero-bg">

    @if (Context.Session.GetString("AccessToken") == null)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

                <div class="container-fluid">

                    <a class="navbar-brand ms-2">
                        Employee Management App
                    </a>

                    <div class="ms-auto">

                        <a class="btn btn-outline-light btn-sm px-3 py-1 rounded-pill shadow-sm custom-btn"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-showLogin="true">

                            SignIn

                        </a>

                    </div>

                </div>

            </nav>
        </header>
    }


    <div class="container-fluid px-0">

        <div class="row g-0">

            @if (Context.Session.GetString("AccessToken") != null)
            {
                <div class="sidebar">

                    <div class="sidebar-logo">
                        EMS
                    </div>


                    <ul class="nav flex-column">

                        <li>
                            <a class="nav-link"
                               asp-controller="Employee"
                               asp-action="GetAllEmployees">

                                Dashboard

                            </a>
                        </li>


                        <li>
                            <a class="nav-link"
                               asp-controller="Employee"
                               asp-action="GetAllEmployees">

                                Employees

                            </a>
                        </li>

                        <li>
                            <a class="nav-link"
                               asp-controller="EmployeeDocument"
                               asp-action="ViewDocuments">

                                Employees

                            </a>
                        </li>


                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="nav-link"
                                   asp-controller="Employee"
                                   asp-action="AddNewEmployee">

                                    Add Employee

                                </a>
                            </li>
                            <li>
                                <a class="nav-link"
                                   asp-controller="EmployeeDocument"
                                   asp-action="UploadDocuments">

                                    Upload Doc

                                </a>
                            </li>
                        }

                        <li class="logout-link">

                            <a class="nav-link"
                               asp-controller="User"
                               asp-action="SignOut">

                                SignOut

                            </a>

                        </li>

                    </ul>

                </div>

                <div class="main-content">

                    <main role="main">

                        @RenderBody()

                    </main>

                </div>
            }
            else
            {

                <div class="col-12">

                    <main role="main">

                        @RenderBody()

                    </main>

                </div>
            }

        </div>

    </div>

    <div class="global-bg">

        <div class="bg-lines"></div>

        <div class="bubble bubble1"></div>
        <div class="bubble bubble2"></div>
        <div class="bubble bubble3"></div>

    </div>


    @if (TempData["SuccessMessage"] != null ||
         TempData["ErrorMessage"] != null)
    {
        <script>

            let icon =
            '@(TempData["SuccessMessage"] != null ? "success" : "error")';

            let message =
            '@(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])';

            Swal.fire({
            icon: icon,
            title: icon === 'success' ? 'Success' : 'Error',
            text: message,
            timer: 3000,
            showConfirmButton: false
            });

        </script>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
